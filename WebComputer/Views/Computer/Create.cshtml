@model WebComputer.ViewModels.ComputerFormViewModel
@{
    ViewData["Title"] = "Thêm Máy tính";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-pastel">
            <div class="card-header card-header-pastel fs-5">
                <i class="fa-solid fa-plus"></i> Thêm mới máy tính
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-bold"><i class="fa-solid fa-tag"></i> Tên máy tính</label>
                            <input asp-for="Name" class="form-control focus-ring" style="--bs-focus-ring-color: rgba(195,177,225, .25)" placeholder="Nhập tên máy..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Brand" class="form-label fw-bold"><i class="fa-solid fa-building"></i> Hãng</label>
                            <input asp-for="Brand" class="form-control" placeholder="VD: Dell, Asus..." />
                            <span asp-validation-for="Brand" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold"><i class="fa-solid fa-sack-dollar"></i> Giá bán ($)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Quantity" class="form-label fw-bold"><i class="fa-solid fa-boxes-stacked"></i> Số lượng kho</label>
                            <input asp-for="Quantity" class="form-control" type="number" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUpload" class="form-label fw-bold"><i class="fa-regular fa-image"></i> Hình ảnh sản phẩm</label>
                        <input asp-for="ImageUpload" class="form-control" type="file" accept="image/*" />
                        <span asp-validation-for="ImageUpload" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold"><i class="fa-solid fa-circle-info"></i> Mô tả chi tiết cấu hình</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="CPU, RAM, Ổ cứng..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/Computer/Index" class="btn btn-light border"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
                        <button type="submit" class="btn btn-pastel px-4"><i class="fa-solid fa-floppy-disk"></i> Lưu sản phẩm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>