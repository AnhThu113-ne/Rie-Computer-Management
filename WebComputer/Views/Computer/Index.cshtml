@model IEnumerable<WebComputer.Models.Computer>
@{
    ViewData["Title"] = "Danh sách Máy tính";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 style="color: var(--pastel-purple-dark); font-weight: 700;">
        <i class="fa-solid fa-list-check"></i> Quản lý danh mục Máy tính
    </h3>
    <a href="/Computer/Create" class="btn btn-pastel rounded-pill px-4 shadow-sm">
        <i class="fa-solid fa-circle-plus"></i> Thêm mới sản phẩm
    </a>
</div>

<div class="card card-pastel bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-pastel mb-0 align-middle text-center">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên máy tính</th>
                        <th>Hãng</th>
                        <th>Giá bán ($)</th>
                        <th>Kho</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@item.Image" alt="@item.Name" class="rounded shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/150';" />
                            </td>
                            <td class="text-start fw-bold">@item.Name</td>
                            <td><span class="badge" style="background-color: var(--pastel-purple);">@item.Brand</span></td>
                            <td class="text-success fw-bold">@item.Price.ToString("N2")</td>
                            <td>
                                @if (item.Quantity > 0)
                                {
                                    <span class="text-primary"><i class="fa-solid fa-check"></i> @item.Quantity</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="fa-solid fa-xmark"></i> Hết</span>
                                }
                            </td>
                            <td>
                                <a href="/Computer/Edit/@item.Id" class="btn btn-sm btn-outline-secondary rounded-circle mx-1" title="Sửa">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a href="/Computer/Delete/@item.Id" class="btn btn-sm btn-outline-danger rounded-circle mx-1" title="Xóa">
                                    <i class="fa-solid fa-trash-can"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>