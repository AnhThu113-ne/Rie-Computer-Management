<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Cửa hàng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <style>
            :root {
                --pastel-purple: #C3B1E1;       /* Tím pastel chính */
                --pastel-purple-light: #F4F0FB; /* Nền tím cực nhạt */
                --pastel-purple-dark: #9B82C3;  /* Tím đậm hơn khi hover */
                --text-dark: #4A3B52;           /* Chữ màu xám tím */
            }
            body {
                background-color: var(--pastel-purple-light);
                color: var(--text-dark);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }
            /* Sidebar styling */
            .sidebar { background-color: white; min-height: 100vh; border-right: 2px solid var(--pastel-purple); box-shadow: 2px 0 5px rgba(0,0,0,0.05); }
            .sidebar a { color: var(--text-dark); text-decoration: none; padding: 12px 15px; display: block; border-radius: 8px; margin: 5px 15px; transition: all 0.3s ease; font-weight: 500; }
            .sidebar a:hover, .sidebar a.active { background-color: var(--pastel-purple); color: white; transform: translateX(5px); }
            .sidebar a i { width: 25px; }
        
            /* Navbar & Card styling */
            .navbar-admin { background-color: var(--pastel-purple); color: white; }
            .btn-pastel { background-color: var(--pastel-purple); color: white; border: none; font-weight: 500; }
            .btn-pastel:hover { background-color: var(--pastel-purple-dark); color: white; }
            .card-pastel { border: 1px solid var(--pastel-purple); border-radius: 10px; box-shadow: 0 4px 15px rgba(195,177,225,0.2); overflow: hidden; }
            .card-header-pastel { background-color: var(--pastel-purple); color: white; font-weight: bold; border-bottom: none; }
        
            /* Table styling */
            .table-pastel thead { background-color: var(--pastel-purple); color: white; }
            .table-pastel th { border-bottom: none; font-weight: 500;}
    </style>
</head>
<body>
    <div class="d-flex">
        <div class="sidebar p-0 col-md-2 d-none d-md-block">
            <h4 class="text-center py-4" style="color: var(--pastel-purple-dark); font-weight: bold;">
                <i class="fa-solid fa-store"></i> MyStore
            </h4>
            <a href="/Computer/Index" class="active"><i class="fa-solid fa-laptop"></i> Quản lý Laptop</a>
            <a href="#"><i class="fa-solid fa-headphones"></i> Quản lý Phụ kiện</a>
            <a href="#"><i class="fa-solid fa-users"></i> Khách hàng</a>
            <hr class="mx-3 my-4" style="border-color: var(--pastel-purple);">
            <a href="/Home/Index"><i class="fa-solid fa-house"></i> Về trang khách</a>
        </div>

        <div class="col-md-10 flex-column d-flex w-100">
            <nav class="navbar navbar-admin p-3 shadow-sm">
                <div class="container-fluid">
                    <span class="navbar-brand mb-0 h5"><i class="fa-solid fa-wand-magic-sparkles"></i> Xin chào, Quản trị viên!</span>
                </div>
            </nav>

            <div class="p-4 flex-grow-1">
                @RenderBody()
            </div>

            <footer class="text-center p-3 text-muted" style="font-size: 0.9rem;">
                <i class="fa-solid fa-heart" style="color: var(--pastel-purple-dark);"></i> Xây dựng với mô hình MVC
            </footer>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>